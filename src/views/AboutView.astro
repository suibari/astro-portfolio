---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import IconsSNS from "../components/IconsSNS.astro";
import { langOf, localizePath, useTranslations } from "../i18n/ui";

const lang = langOf(Astro.currentLocale);
const t = useTranslations(lang);

const text = {
  ja: {
    hello: "はじめまして！",
    intro: [
      "このサイトは すいばり の作品や活動をまとめたものです。",
      "主に開発・イラスト・ブログを中心に活動しています。",
    ],
    charterBefore: "活動の方針は",
    charterAfter: "にまとめています。",
    charactersBefore: "キャラクターたちについては",
    charactersAfter: "にいます。",
    support: "このサイトおよび、それぞれの開発物はすいばり個人で運用管理しており、あなたの応援が励みになります。もしよければ以下から支援を送っていただけるとたいへん嬉しいです。",
    supportButtons: ["OFUSEで応援を送る", "FANBOXで支援する", "Patreonで支援する"],
    usesTitle: "ご支援は以下に使わせていただきます！",
    uses: [
      "毎日をがんばるためのコーヒー1杯",
      "開発物の運用管理費（サーバ電気代など）",
      "イラストの機材費",
      "開発やイラストの勉強費用（書籍など）",
      "次回作品へのモチベーション！",
    ],
    contact: "ご意見やご感想がありましたら、以下のSNSからお気軽にお知らせください。",
  },
  en: {
    hello: "Hi there!",
    intro: [
      "This site collects the things I, suibari, make and do.",
      "I mostly build apps, draw illustrations, and write.",
    ],
    charterBefore: "The principles behind my work are written up in",
    charterAfter: ".",
    charactersBefore: "My characters live at",
    charactersAfter: ".",
    support: "I run this site and everything I build on my own, and your support keeps me going. If you'd like to, you can send support through any of the links below — it would make me very happy.",
    supportButtons: ["Support on OFUSE", "Support on FANBOX", "Support on Patreon"],
    usesTitle: "Your support goes toward:",
    uses: [
      "A cup of coffee to keep going every day",
      "Running costs for my apps (servers, electricity, etc.)",
      "Drawing equipment",
      "Learning materials for development and illustration (books, etc.)",
      "Motivation for the next project!",
    ],
    contact: "If you have feedback or thoughts, feel free to reach out on any of these.",
  },
}[lang];

const supportLinks = ["https://ofuse.me/o?uid=85918", "https://suibari.fanbox.cc/", "https://www.patreon.com/suibari"];
---

<Layout title="About" description={t("about.description")}>
  <PageHero title="About" />
  <div class="container">
    <div class="prose">
      <p>{text.hello}</p>
      <p>{text.intro.map((line) => <>{line}<br /></>)}</p>
      <p>
        {text.charterBefore} <a class="text-link" href={localizePath(lang, "/nexus")}>Creative Nexus</a>{text.charterAfter}<br />
        {text.charactersBefore} <a class="text-link" href="https://bot-tan.com" target="_blank" rel="noopener noreferrer">bot-tan.com</a>{text.charactersAfter}
      </p>
    </div>

    <section>
      <h2 class="font-pixel">Support<span class="cursor" aria-hidden="true">_</span></h2>
      <div class="prose"><p>{text.support}</p></div>
      <div class="support">
        {
          supportLinks.map((href, i) => (
            <a href={href} target="_blank" rel="noopener noreferrer">{text.supportButtons[i]}</a>
          ))
        }
      </div>
      <div class="prose">
        <p>{text.usesTitle}</p>
        <ul>{text.uses.map((use) => <li>{use}</li>)}</ul>
      </div>
    </section>

    <section>
      <h2 class="font-pixel">Contact<span class="cursor" aria-hidden="true">_</span></h2>
      <div class="prose"><p>{text.contact}</p></div>
      <IconsSNS />
    </section>
  </div>
</Layout>

<style>
  section {
    margin-top: 48px;
  }
  h2 {
    display: inline-block;
    margin: 0 0 12px;
    font-size: 2rem;
    line-height: 1.2;
    border-bottom: 4px solid var(--blue);
  }
  .prose {
    font-size: 0.9375rem;
  }
  .prose p {
    margin: 0 0 12px;
  }
  .prose ul {
    margin: 0;
    padding-left: 1.25em;
    list-style: none;
    color: var(--ink-soft);
  }
  .prose li::before {
    content: ">";
    margin-left: -1.1em;
    margin-right: 0.45em;
    font-family: "VT323", monospace;
    color: var(--orange-ink);
  }
  .support {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 4px 0 20px;
  }
  .support a {
    padding: 8px 18px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .support a:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--orange);
  }
</style>
