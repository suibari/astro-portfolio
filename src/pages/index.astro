---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectList from "../components/ProjectList.astro";
import IllustGrid from "../components/IllustGrid.astro";
import BlogList from "../components/BlogList.astro";
import MerchGrid from "../components/MerchGrid.astro";
import { getProjects } from "../lib/projects";
import { getBlogPosts, getIllustrations } from "../lib/feeds";

const [projects, illustrations, posts] = await Promise.all([
  getProjects(),
  getIllustrations(),
  getBlogPosts(),
]);
---

<Layout>
  <Hero />
  <div class="container sections">
    <section>
      <SectionHeading title="Projects" more={{ href: "/projects", label: `すべて見る（${projects.length}）` }} />
      <ProjectList projects={projects.slice(0, 3)} />
    </section>
    <section>
      <SectionHeading title="Illustrations" more={{ href: "/illust" }} />
      <IllustGrid items={illustrations.slice(0, 3)} />
    </section>
    <section>
      <SectionHeading title="Blog" more={{ href: "/blog" }} />
      <BlogList posts={posts.slice(0, 3)} />
    </section>
    <section>
      <SectionHeading title="Merch" more={{ href: "https://suzuri.jp/suibari", label: "SUZURI" }} />
      <MerchGrid />
    </section>
  </div>
</Layout>

<style>
  .sections {
    display: grid;
    gap: 72px;
  }
</style>
