---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import IllustGrid from "../components/IllustGrid.astro";
import { getIllustrations } from "../lib/feeds";

const illustrations = await getIllustrations();
---

<Layout title="Illustrations" description="すいばりのイラスト一覧">
  <div class="container page">
    <SectionHeading title="Illustrations" level="h1" more={{ href: "https://www.pixiv.net/users/251033", label: "pixiv" }} />
    <IllustGrid items={illustrations} />
  </div>
</Layout>

<style>
  .page {
    padding-top: 48px;
  }
</style>
