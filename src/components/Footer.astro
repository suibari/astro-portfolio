---
import IconsSNS from "./IconsSNS.astro";
---

<footer class="site-footer dots">
  <div class="container inner">
    <p class="mark"><span class="font-pixel">S.O.S.!!</span> © suibari</p>
    <IconsSNS tone="light" />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    background-color: var(--blue-deep);
    color: #fff;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-block: 24px 32px;
  }
  .mark {
    margin: 0;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .mark .font-pixel {
    font-size: 1.5rem;
    color: #fff;
    margin-right: 6px;
  }
</style>
