---
// Nagiのロゴ（PNG）の形だけを使い、ほかのアイコンと同じく文字色（currentColor）で塗る
const props = Astro.props;
---

<span class="nagi-icon" aria-hidden="true" {...props}></span>

<style>
  .nagi-icon {
    display: inline-block;
    width: 1.25em;
    height: 1.25em;
    background: currentColor;
    -webkit-mask: url("/images/nagi-icon-mask.png") center / contain no-repeat;
    mask: url("/images/nagi-icon-mask.png") center / contain no-repeat;
  }
</style>
