---
import type { Illustration } from "../lib/feeds";

interface Props {
  items: Illustration[];
}
const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="empty">イラストを読み込めませんでした。<a class="text-link" href="https://www.pixiv.net/users/251033" target="_blank" rel="noopener noreferrer">pixiv</a> で見られます。</p>
  ) : (
    <ul class="grid">
      {items.map((item) => (
        <li>
          <a href={item.link} target="_blank" rel="noopener noreferrer">
            <img src={item.image} alt="" loading="lazy" decoding="async" />
            <span class="caption">{item.title}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid a {
    display: block;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--blue-soft);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  a:hover img {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .caption {
    display: block;
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a:hover .caption {
    color: var(--ink);
  }
  .empty {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
    }
  }
</style>
