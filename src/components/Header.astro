---
import { langOf, localizePath, useTranslations } from "../i18n/ui";

const lang = langOf(Astro.currentLocale);
const t = useTranslations(lang);
const other = lang === "ja" ? "en" : "ja";
const current = localizePath("ja", Astro.url.pathname.replace(/\/+$/, "") || "/");
const links = [
  { href: "/nexus", label: t("nav.nexus") },
  { href: "/projects", label: t("nav.projects") },
  { href: "/illust", label: t("nav.illust") },
  { href: "/blog", label: t("nav.blog") },
  { href: "/about", label: t("nav.about") },
];
---

<header class="site-header">
  <div class="container inner">
    <a href={localizePath(lang, "/")} class="logo font-pixel" aria-label={`S.O.S.!! ${t("about.top")}`}>
      S.O.S.!!<span class="cursor logo-cursor" aria-hidden="true">_</span>
    </a>
    <nav aria-label={t("nav.label")}>
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={localizePath(lang, href)} aria-current={current === href ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="https://bot-tan.com" target="_blank" rel="noopener noreferrer">
            {t("nav.characters")}<span class="ext" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
    <a
      class="lang"
      href={localizePath(other, Astro.url.pathname)}
      hreflang={other}
      lang={other}
      data-lang={other}
    >
      <span class="font-pixel" aria-hidden="true">{lang === "ja" ? "JA" : "EN"}<b>/</b>{lang === "ja" ? "EN" : "JA"}</span>
      <span class="sr-only">{t("lang.switch")}</span>
    </a>
  </div>
</header>

<script>
  // 言語を手動で選んだら、次からはその言語で開く
  // 絞り込みなどの ?tag= も引き継ぐ
  document.querySelector<HTMLAnchorElement>(".site-header .lang")?.addEventListener("click", (event) => {
    const link = event.currentTarget as HTMLAnchorElement;
    try {
      localStorage.setItem("lang", link.dataset.lang ?? "ja");
    } catch {}
    link.href = link.pathname + location.search + location.hash;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--blue);
    color: #fff;
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 10px;
  }
  .logo {
    font-size: 2rem;
    line-height: 1;
  }
  /* ロゴのカーソルはホバーしたときだけ点滅させる */
  .logo-cursor {
    opacity: 0;
    animation: none;
  }
  .logo:hover .logo-cursor,
  .logo:focus-visible .logo-cursor {
    opacity: 1;
    animation: blink 1.06s step-end infinite;
  }
  nav {
    margin-left: auto;
    min-width: 0;
  }
  ul {
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
  }
  nav a {
    display: inline-block;
    padding-block: 6px;
    color: rgba(255, 255, 255, 0.78);
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav a:hover {
    color: #fff;
  }
  nav a[aria-current="page"] {
    color: #fff;
    border-color: var(--orange);
  }
  .ext {
    margin-left: 2px;
    font-size: 0.75em;
  }
  .lang {
    flex-shrink: 0;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 1.25rem;
    line-height: 1.3;
    transition: background-color 0.15s;
  }
  .lang b {
    margin-inline: 3px;
    font-weight: 400;
    opacity: 0.5;
  }
  .lang:hover {
    background: var(--orange);
    color: var(--ink);
  }
  /* スマホではメニューを2段目に回し、横にスクロールできるようにする */
  @media (max-width: 760px) {
    .inner {
      flex-wrap: wrap;
      row-gap: 0;
      padding-bottom: 0;
    }
    .lang {
      margin-left: auto;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    ul {
      gap: 16px;
      font-size: 0.8125rem;
    }
  }
</style>
