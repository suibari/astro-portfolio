---
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/illust", label: "Illustrations" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="logo font-pixel" aria-label="S.O.S.!! トップへ">
      S.O.S.!!<span class="cursor logo-cursor" aria-hidden="true">_</span>
    </a>
    <nav aria-label="メインメニュー">
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={path === href ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="https://bot-tan.com" target="_blank" rel="noopener noreferrer">
            Characters<span class="ext" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 24px;
    padding-block: 10px;
  }
  .logo {
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
  }
  /* ロゴのカーソルはホバーしたときだけ点滅させる */
  .logo-cursor {
    opacity: 0;
    animation: none;
  }
  .logo:hover .logo-cursor,
  .logo:focus-visible .logo-cursor {
    opacity: 1;
    animation: blink 1.06s step-end infinite;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 500;
  }
  nav a {
    display: inline-block;
    padding-block: 6px;
    color: var(--ink-soft);
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current="page"] {
    color: var(--ink);
    border-color: var(--orange);
  }
  @media (max-width: 520px) {
    .inner {
      padding-block: 8px 0;
    }
    ul {
      gap: 0 14px;
      font-size: 0.8125rem;
    }
  }
  .ext {
    margin-left: 2px;
    font-size: 0.75em;
  }
</style>
