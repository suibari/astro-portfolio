---
import { Image } from "astro:assets";
import IconsSNS from "./IconsSNS.astro";
import botTan from "../assets/hero/bot-tan.png";
import { langOf, useTranslations } from "../i18n/ui";

const t = useTranslations(langOf(Astro.currentLocale));
const title = "S.O.S.!!";
const subtitle = t("hero.subtitle");
---

<section class="hero dots" aria-label={title}>
  <div class="mascot" aria-hidden="true">
    <Image src={botTan} alt="" widths={[360, 540, 720]} sizes="(max-width: 760px) 240px, 360px" loading="eager" />
  </div>
  <div class="container">
    <!-- ロゴは botたんがペンキで塗った文字。左から塗っていく -->
    <h1 class="title"><span class="paint">{title}</span></h1>
    <p class="subtitle">
      <span class="sr-only">{subtitle}</span>
      <span class="typed" data-text={subtitle} aria-hidden="true">{subtitle}</span><span
        class="cursor"
        aria-hidden="true">_</span
      >
    </p>
    <p class="intro">{t("hero.intro")}</p>
    <IconsSNS tone="light" />
  </div>
</section>

<style>
  .hero {
    background-color: var(--blue);
    color: #fff;
    padding-block: 48px 104px; /* 下は Creative Nexus のカードが重なる分 */
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    /* 左側のドットを青で塗りつぶして、右上にだけ模様を残す */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, var(--blue) 45%, transparent 75%);
    pointer-events: none;
  }
  .hero .container {
    position: relative;
    z-index: 1;
  }
  /* 右側に元の色のまま薄く立つ botたん。下端は Creative Nexus のカードの裏に隠れる */
  .mascot {
    position: absolute;
    right: max(-24px, calc(50% - var(--content-width) / 2 - 140px));
    bottom: 0;
    height: 112%;
    opacity: 0.5;
    pointer-events: none;
    /* 左（タイトル側）へ向かってふわっと消す */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 28%);
    mask-image: linear-gradient(to right, transparent 0%, #000 28%);
  }
  .mascot :global(img) {
    display: block;
    height: 100%;
    width: auto;
  }
  @media (max-width: 760px) {
    .mascot {
      right: -64px;
      height: 82%;
      opacity: 0.3;
    }
  }
  .title {
    margin: 0;
    font-family: "Rubik Wet Paint", "VT323", monospace;
    font-weight: 400;
    font-size: clamp(4rem, 15vw, 7.75rem);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--orange);
    text-shadow: 0 5px 0 rgba(12, 29, 74, 0.35);
  }
  .paint {
    display: inline-block;
    /* 下に垂れたペンキと影まで含めて切り抜く */
    padding: 0 0.08em 0.12em 0;
    animation: paint 1.1s cubic-bezier(0.55, 0.1, 0.3, 1) 0.2s both;
  }
  @keyframes paint {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .subtitle {
    margin: 16px 0 0;
    min-height: 3.6em;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.8;
    white-space: pre-line;
  }
  .intro {
    margin: 8px 0 16px;
    max-width: 34em;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.82);
  }
  .subtitle .cursor {
    margin-left: 2px;
    font-size: 1.5em;
    line-height: 0;
  }
  .hero :global(.sns) {
    margin-left: -8px;
  }
</style>

<script>
  // ロゴを塗り終えたら、副題を1文字ずつ打ち込む
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  async function type(target: HTMLElement, cursor: HTMLElement, speed: number) {
    const text = target.dataset.text ?? "";
    target.textContent = "";
    target.after(cursor);
    for (const char of text) {
      target.textContent += char;
      await sleep(char === "\n" ? speed * 4 : speed);
    }
  }

  async function run() {
    const subtitle = document.querySelector<HTMLElement>(".hero .typed");
    const cursor = document.querySelector<HTMLElement>(".hero .cursor");
    if (!subtitle || !cursor) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    subtitle.textContent = "";
    await sleep(1200);
    await type(subtitle, cursor, 60);
  }

  run();
</script>
