---
import IconsSNS from "./IconsSNS.astro";
import { langOf, useTranslations } from "../i18n/ui";

const t = useTranslations(langOf(Astro.currentLocale));
const title = "S.O.S.!!";
const subtitle = t("hero.subtitle");
---

<section class="hero dots" aria-label={title}>
  <div class="container">
    <h1 class="title font-pixel">
      <span class="sr-only">{title}</span>
      <span class="typed" data-text={title} aria-hidden="true">{title}</span><span
        class="cursor"
        aria-hidden="true">_</span
      >
    </h1>
    <p class="subtitle">
      <span class="sr-only">{subtitle}</span>
      <span class="typed" data-text={subtitle} aria-hidden="true">{subtitle}</span>
    </p>
    <p class="intro">{t("hero.intro")}</p>
    <IconsSNS tone="light" />
  </div>
</section>

<style>
  .hero {
    background-color: var(--blue);
    color: #fff;
    padding-block: 48px 104px; /* 下は Creative Nexus のカードが重なる分 */
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    /* 左側のドットを青で塗りつぶして、右上にだけ模様を残す */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, var(--blue) 45%, transparent 75%);
    pointer-events: none;
  }
  .hero .container {
    position: relative;
  }
  .title {
    margin: 0;
    font-size: clamp(4.5rem, 16vw, 8.5rem);
    line-height: 0.9;
  }
  .subtitle {
    margin: 16px 0 0;
    min-height: 3.6em;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.8;
    white-space: pre-line;
  }
  .intro {
    margin: 8px 0 16px;
    max-width: 34em;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.82);
  }
  .subtitle .cursor {
    margin-left: 2px;
    font-size: 1.5em;
    line-height: 0;
  }
  .hero :global(.sns) {
    margin-left: -8px;
  }
</style>

<script>
  // 文字を1つずつ打ち込み、カーソルを打っている行へ移していく
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  async function type(target: HTMLElement, cursor: HTMLElement, speed: number) {
    const text = target.dataset.text ?? "";
    target.textContent = "";
    target.after(cursor);
    for (const char of text) {
      target.textContent += char;
      await sleep(char === "\n" ? speed * 4 : speed);
    }
  }

  async function run() {
    const [title, subtitle] = document.querySelectorAll<HTMLElement>(".hero .typed");
    const cursor = document.querySelector<HTMLElement>(".hero .cursor");
    if (!title || !subtitle || !cursor) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      subtitle.after(cursor);
      return;
    }
    subtitle.textContent = "";
    await type(title, cursor, 140);
    await sleep(400);
    await type(subtitle, cursor, 60);
  }

  run();
</script>
