---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { langOf, localizePath, useTranslations } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
}

const lang = langOf(Astro.currentLocale);
const t = useTranslations(lang);
const siteName = "S.O.S.!!";
const { title, description = t("site.description") } = Astro.props;
const pageTitle = title ? `${title} - ${siteName}` : `${siteName} - Suibari’s Website`;
const origin = "https://suibari.com";
const canonical = new URL(Astro.url.pathname, origin);
const jaUrl = new URL(localizePath("ja", Astro.url.pathname), origin);
const enUrl = new URL(localizePath("en", Astro.url.pathname), origin);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      lang === "ja" && (
        // 初回はブラウザの言語で英語ページへ。言語切替で選んだものは localStorage に覚える
        <script is:inline>
          (function () {
            try {
              var saved = localStorage.getItem("lang");
              var langs = navigator.languages || [navigator.language || ""];
              var prefersJa = langs.some(function (l) { return /^ja\b/i.test(l); });
              if (saved === "en" || (!saved && !prefersJa)) {
                var p = location.pathname;
                location.replace((p === "/" ? "/en/" : "/en" + p) + location.search + location.hash);
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;700;800&family=VT323&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={jaUrl} />
    <meta name="theme-color" content="#1450f5" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://suibari.com/ogp.png" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
  </head>
  <body>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
